# OSS 文件智能问答（通义千问 RAG）配置模板
#
# 说明：本目录（前端仓库下的 ai/）存放已构建的检索索引 cache/ 与 index/，
# 代码实现位于后端仓库 patent/patent/ai/oss_qa/。
#
# 使用方式：把本文件复制为同目录下的 .env，再填入真实值。
# .env 已被 .gitignore 排除，切勿提交真实凭据。

# 通义千问 API Key（必填）
DASHSCOPE_API_KEY=replace-with-your-dashscope-key

# OSS 配置：仅当 export_urls.csv 中的 URL 无法匿名访问时才需要填写
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=replace-with-your-bucket
OSS_ACCESS_KEY_ID=replace-with-your-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-access-key-secret

# 若使用 STS 临时凭证，取消下面一行注释
# OSS_STS_TOKEN=replace-with-your-sts-token
